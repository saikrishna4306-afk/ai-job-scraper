# ============================================================
# Autonomous AI Job Hunter — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default, local): sqlite:///storage/job_agent.db
# PostgreSQL/Supabase: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///storage/job_agent.db

# --- Gemini AI (official SDK) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram Bot ---
# Create a bot with BotFather, then set the token and allow-listed chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=300

# --- Gmail OAuth (drafts only by default) ---
# Create an OAuth desktop client, then set these variables and complete OAuth
# to generate storage/gmail_token.json.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_PATH=storage/gmail_token.json

# --- Supabase (cloud persistence) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=job-hunter-documents

# --- Job Discovery Preferences ---
REMOTE_ONLY=true          # Only show remote roles by default
WORLDWIDE_REMOTE=false    # Allow worldwide remote (not just India-based)
INDIA_REMOTE=true         # Allow India-based applicants for remote roles
JOB_LOOKBACK_HOURS=24     # How far back to search for posted jobs
MINIMUM_MATCH_SCORE=7     # Minimum match score (1-10) to consider a job relevant
MAX_JOBS_PER_PLATFORM=20  # Max jobs fetched per platform per run

# --- Application & Outreach ---
AUTO_APPLY_ENABLED=false  # If true, skip approval and attempt auto-submission
REQUIRE_APPROVAL=true     # If true, requires explicit approval before each application
OUTREACH_AUTO_SEND=false  # If true, send outreach emails without manual review
FOLLOW_UP_DAYS=7          # Default follow-up interval in days

# --- Platform Integrations ---
# These are optional; leave empty to disable corresponding features.
# Do not store plaintext passwords or session cookies here.

# --- Security ---
# Enable mock mode when no external credentials are available.
# All external integrations (Gemini, Telegram, Gmail, Supabase) fall back to mock/safe defaults when keys are missing.
TELEGRAM_TIMEOUT_SECONDS=300
